{
  "name": "optiflow-desktop",
  "productName": "OptiFlow Pro",
  "version": "5.5.0",
  "description": "OptiFlow Pro — masaüstü uygulaması; Medula köprüsü dahili, Chrome eklentisi gerektirmez.",
  "author": "OptiFlow",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:staging": "node scripts/build.mjs --env=staging",
    "build:production": "node scripts/build.mjs --env=production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:server": "node tests/server/api-integration.mjs",
    "test:e2e": "node scripts/build.mjs && node tests/e2e/build-e2e.mjs && electron dist-e2e/e2e-main.js",
    "start": "node scripts/build.mjs --env=development && electron .",
    "pack:dir": "node scripts/build.mjs --env=production && electron-builder --dir --publish never",
    "dist:win": "node scripts/build.mjs --env=production && electron-builder --win --x64 --publish never -c.win.forceCodeSigning=false",
    "dist:win:staging": "node scripts/build.mjs --env=staging && electron-builder --win --x64 --publish never -c.win.forceCodeSigning=false",
    "release:win": "node scripts/build.mjs --env=production && electron-builder --win --x64 --publish always",
    "dist:win:imzali": "node scripts/imzali-derle.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
