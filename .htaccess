# OptiFlow — kök güvenlik kuralları + tek yönlendirme (www → çıplak alan adı, SEO için).
# Amaç: PHP çözümlemesi bir an devre dışı kalsa bile config.php, yedekler ve
# log/dosya kalıntıları web'den okunamasın.

# SEO: www.optiflow.com.tr → https://optiflow.com.tr (kalıcı 301). Yalnızca www için çalışır; döngü riski yok.
# (HTTP → HTTPS yönlendirmesi Plesk › SSL/TLS ayarından yapılır.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.optiflow\.com\.tr$ [NC]
  RewriteRule ^(.*)$ https://optiflow.com.tr/$1 [R=301,L]
</IfModule>

# Dizin listelemeyi kapat
Options -Indexes

# Hassas dosya kalıpları: config, yedek, log, sql, env, ini, bak, betik dökümleri
<FilesMatch "(^\.|config\.php$|\.(bak|log|sql|sqlite|env|ini|sh|tpl|dist|old|orig|swp)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# manifest.json vb. bilerek servis edilir; yukarıdaki desen bunları etkilemez.

# Statik dosyalar için uzun tarayıcı önbelleği (4.9.0).
# Dosyalar sayfada ?v=<sürüm/tarih> ile çağrıldığı için güncellenince tarayıcı yenisini alır.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
